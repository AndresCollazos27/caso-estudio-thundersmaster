# Copie este archivo como .env y cambie los valores.

# Puerto en el que escucha la app. Hay que abrirlo en el firewall.
PORT=8090

# Dirección con la que los celulares llegan al servidor: http, la IP pública del VPS y el puerto, sin barra al final.
# Sale en el QR de la pantalla de Leandro.
PUBLIC_URL=http://203.0.113.24:8090

# Claves de los enlaces secretos de Leandro y de los autores. Use claves largas, por ejemplo: openssl rand -base64 24
HOST_TOKEN=cambie-esta-clave-de-leandro
ADMIN_TOKEN=cambie-esta-clave-de-los-autores

# Zona horaria del servidor, para la hora en el nombre de las exportaciones.
TZ=America/Argentina/Buenos_Aires

# Carpeta del registro de eventos. Con Docker no hace falta: se monta ./data en /app/data.
DATA_DIR=./data
